# Copy to `.env`. Only VITE_-prefixed vars reach the browser.

# Sanity — find the project ID at https://www.sanity.io/manage
# These are public by design: the dataset is read-only over the CDN.
# Never put a Sanity write token in this file.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Contact form endpoint (Google Apps Script web app URL)
VITE_API_URL=
